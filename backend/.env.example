# 可复制为 backend/.env 作为页面配置之外的后备设置。
# 不要在前端 VITE_ 变量、源码或文档中填写真实密钥。
# 可选：生产环境可提供固定 32 字节 Base64 或 64 位十六进制主密钥；留空时自动生成 gitignored 本机密钥文件。
OCR_CONFIG_ENCRYPTION_KEY=
BAIDU_OCR_API_KEY=your_api_key
BAIDU_OCR_SECRET_KEY=your_secret_key
BAIDU_OCR_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/general_basic